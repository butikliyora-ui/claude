      },
      { "type": "checkbox", "id": "show_knit_pattern", "label": "Örgü dokusu desenini göster", "info": "Boş alanlarda ve vurgulu bölümlerde ince bir örgü dokusu kullanır.", "default": true }
    ]
  },
  {
    "name": "Ürün kartları",
    "settings": [
      {
        "type": "select", "id": "card_image_ratio", "label": "Görsel oranı", "default": "portrait",
        "options": [
