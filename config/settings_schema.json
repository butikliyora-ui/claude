      {
        "type": "select", "id": "button_shape", "label": "Buton şekli", "default": "pill",
        "options": [
          { "value": "pill", "label": "Hap (tam yuvarlak)" },
          { "value": "rounded", "label": "Yuvarlak köşe" },
          { "value": "square", "label": "Köşeli" }
