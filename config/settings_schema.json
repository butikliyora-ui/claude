      { "type": "checkbox", "id": "card_show_secondary_image", "label": "Üzerine gelince ikinci görseli göster", "default": true },
      { "type": "checkbox", "id": "card_show_quick_add", "label": "Hızlı sepete ekle butonu", "default": true },
