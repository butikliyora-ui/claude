      { "type": "color", "id": "color_sale", "label": "İndirim etiketi", "default": "#B8392B" }
    ]
  },
  {
    "name": "Yazı tipleri",
    "settings": [
      { "type": "font_picker", "id": "type_header_font", "label": "Başlık yazı tipi", "default": "lora_n4" },
      { "type": "font_picker", "id": "type_body_font", "label": "Gövde yazı tipi", "default": "nunito_sans_n4" },
      {
        "type": "range", "id": "heading_scale", "label": "Başlık boyutu", "min": 80, "max": 140, "step": 5, "unit": "%", "default": 100
      },
      {
        "type": "range", "id": "body_scale", "label": "Gövde metni boyutu", "min": 90, "max": 120, "step": 5, "unit": "%", "default": 100
      }
    ]
  },
  {
    "name": "Düzen",
    "settings": [
      { "type": "range", "id": "page_width", "label": "Sayfa genişliği", "min": 1000, "max": 1600, "step": 20, "unit": "px", "default": 1320 },
