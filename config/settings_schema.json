          { "value": "page", "label": "Sepet sayfasına git" }
        ]
      },
      { "type": "checkbox", "id": "cart_show_note", "label": "Sipariş notu alanını göster", "info": "Müşteriler renk/isim gibi özel isteklerini yazabilir.", "default": true },
      {
        "type": "number", "id": "free_shipping_threshold", "label": "Ücretsiz kargo limiti",
        "info": "Mağaza para birimi cinsinden. 0 yazarsanız ilerleme çubuğu gizlenir.", "default": 750
      }
    ]
  },
  {
    "name": "İletişim ve WhatsApp",
    "settings": [
      { "type": "text", "id": "whatsapp_number", "label": "WhatsApp numarası", "info": "Ülke koduyla, boşluksuz. Örnek: 905551112233" },
      { "type": "text", "id": "whatsapp_message", "label": "Hazır mesaj", "default": "Merhaba, sitenizden yazıyorum. Bilgi almak istiyorum." },
      { "type": "checkbox", "id": "show_whatsapp_float", "label": "Sağ altta WhatsApp butonu göster", "default": true },
      { "type": "text", "id": "contact_email", "label": "İletişim e-postası" }
    ]
  },
  {
    "name": "Sosyal medya",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram", "default": "https://www.instagram.com/ilknurun.ilmeklerii" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok" },
      { "type": "text", "id": "social_facebook", "label": "Facebook" },
      { "type": "text", "id": "social_pinterest", "label": "Pinterest" },
      { "type": "text", "id": "social_youtube", "label": "YouTube" }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "Favicon görseli", "info": "32 x 32 px önerilir." }
    ]
