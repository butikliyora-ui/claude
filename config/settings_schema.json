      { "type": "color", "id": "color_text", "label": "Metin", "default": "#3A2E2A" },
      { "type": "color", "id": "color_muted", "label": "İkincil metin", "default": "#7D6C63" },
      { "type": "color", "id": "color_border", "label": "Çizgi ve kenarlıklar", "default": "#E7D9C8" },
