{%- comment -%}
  Parametreler:
  - product: ürün (boşsa örnek kart gösterilir)
  - placeholder_title, placeholder_price, placeholder_index: örnek kart için
  - lazy: görseller tembel yüklensin mi (varsayılan true)
{%- endcomment -%}
{%- liquid
  assign ratio_class = 'ratio--' | append: settings.card_image_ratio
  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif
-%}

{%- if product != blank -%}
  {%- liquid
    assign first_image = product.featured_media
    assign second_image = product.media[1]
    assign on_sale = false
    if product.compare_at_price > product.price
      assign on_sale = true
      assign discount = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round
    endif
  -%}
  <div class="card{% if settings.card_show_secondary_image and second_image %} card--has-secondary{% endif %}">
    <div class="card__media-wrap">
    <a href="{{ product.url }}" class="card__media {{ ratio_class }}"{% if settings.card_image_ratio == 'natural' and first_image %} style="--ratio: {{ first_image.aspect_ratio }}"{% endif %}>
      {%- if first_image -%}
        {{
          first_image
          | image_url: width: 900
          | image_tag:
            loading: loading,
            widths: '300, 450, 600, 750, 900',
            sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
            class: 'card__img card__img--primary',
            alt: first_image.alt | default: product.title
        }}
        {%- if settings.card_show_secondary_image and second_image -%}
          {{
            second_image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '300, 450, 600, 750, 900',
              sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
              class: 'card__img card__img--secondary',
              alt: ''
          }}
        {%- endif -%}
      {%- else -%}
        <span class="card__placeholder">{% render 'icon', name: 'yarn' %}</span>
      {%- endif -%}

      <span class="card__badges">
        {%- if product.available == false -%}
          <span class="badge badge--soldout">{{ 'products.product.sold_out' | t }}</span>
        {%- elsif on_sale -%}
          <span class="badge badge--sale">-%{{ discount }}</span>
        {%- endif -%}
        {%- if settings.show_handmade_badge and settings.handmade_badge_text != blank -%}
          <span class="badge badge--handmade">{% render 'icon', name: 'hand' %}{{ settings.handmade_badge_text }}</span>
        {%- endif -%}
      </span>
    </a>
    {%- if settings.card_show_quick_add and product.available -%}
      {%- if product.has_only_default_variant -%}
        {%- form 'product', product, class: 'card__quick-add', data-product-form: '' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" name="add" class="card__quick-btn" aria-label="{{ 'products.product.add_to_cart' | t }}: {{ product.title | escape }}">
            {% render 'icon', name: 'plus' %}<span>{{ 'products.product.add_short' | t }}</span>
          </button>
        {%- endform -%}
      {%- else -%}
        <a href="{{ product.url }}" class="card__quick-btn card__quick-btn--link" aria-label="{{ 'products.product.choose_options' | t }}: {{ product.title | escape }}">
          {% render 'icon', name: 'arrow' %}<span>{{ 'products.product.choose_options' | t }}</span>
        </a>
      {%- endif -%}
    {%- endif -%}
    </div>

    <div class="card__info">
      <h3 class="card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
      {% render 'price', product: product %}
    </div>

  </div>
{%- else -%}
  {%- assign ph = placeholder_index | default: 1 | modulo: 6 -%}
  <div class="card card--placeholder">
    <div class="card__media {{ ratio_class }} card__media--ph-{{ ph }}">
      <span class="card__placeholder">{% render 'icon', name: 'yarn' %}</span>
      <span class="card__badges">
        {%- if settings.show_handmade_badge and settings.handmade_badge_text != blank -%}
          <span class="badge badge--handmade">{% render 'icon', name: 'hand' %}{{ settings.handmade_badge_text }}</span>
        {%- endif -%}
      </span>
    </div>
    <div class="card__info">
      <h3 class="card__title">{{ placeholder_title | default: 'Örnek ürün' }}</h3>
      {% render 'price', placeholder_price: placeholder_price %}
    </div>
  </div>
{%- endif -%}
