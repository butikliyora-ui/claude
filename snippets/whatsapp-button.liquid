{%- liquid
  assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' '
  assign wa_text = settings.whatsapp_message
  if request.page_type == 'product'
    assign wa_text = 'products.product.whatsapp_message' | t: title: product.title, url: canonical_url
  endif
-%}
<a
  class="wa-float"
  href="https://wa.me/{{ wa_number }}?text={{ wa_text | url_encode }}"
  target="_blank"
  rel="noopener"
  aria-label="{{ 'general.whatsapp_label' | t }}"
>
  {% render 'icon', name: 'whatsapp' %}
  <span class="wa-float__label">{{ 'general.whatsapp_short' | t }}</span>
</a>
