{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  if settings.free_shipping_threshold > 0
    assign remaining = threshold | minus: cart.total_price
    assign percent = cart.total_price | times: 100 | divided_by: threshold
    if percent > 100
      assign percent = 100
    endif
  endif
-%}
{%- if settings.free_shipping_threshold > 0 and cart.item_count > 0 -%}
  <div class="ship-bar">
    <p>
      {%- if remaining > 0 -%}
        {%- assign remaining_money = remaining | money -%}
        {{ 'cart.shipping_remaining_html' | t: amount: remaining_money }}
      {%- else -%}
        {% render 'icon', name: 'truck' %}{{ 'cart.shipping_free' | t }}
      {%- endif -%}
    </p>
    <div class="ship-bar__track"><span style="width: {{ percent }}%"></span></div>
  </div>
{%- endif -%}
