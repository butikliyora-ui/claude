{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" class="pagination__arrow pagination__arrow--prev" aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow' %}</a>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}" class="pagination__page">{{ part.title }}</a>
      {%- elsif part.title == paginate.current_page -%}
        <span class="pagination__page is-current" aria-current="page">{{ part.title }}</span>
      {%- else -%}
        <span class="pagination__page">{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" class="pagination__arrow" aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow' %}</a>
    {%- endif -%}
  </nav>
{%- endif -%}
