<div class="contact-form__row">
  <div class="field">
    <label for="AddrFirst-{{ id }}">{{ 'customer.fields.first_name' | t }}</label>
    <input id="AddrFirst-{{ id }}" type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
  </div>
  <div class="field">
    <label for="AddrLast-{{ id }}">{{ 'customer.fields.last_name' | t }}</label>
    <input id="AddrLast-{{ id }}" type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
  </div>
</div>
<div class="field">
  <label for="Addr1-{{ id }}">{{ 'customer.fields.address1' | t }}</label>
  <input id="Addr1-{{ id }}" type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1">
</div>
<div class="field">
  <label for="Addr2-{{ id }}">{{ 'customer.fields.address2' | t }}</label>
  <input id="Addr2-{{ id }}" type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
</div>
<div class="contact-form__row">
  <div class="field">
    <label for="AddrCity-{{ id }}">{{ 'customer.fields.city' | t }}</label>
    <input id="AddrCity-{{ id }}" type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2">
  </div>
  <div class="field">
    <label for="AddrZip-{{ id }}">{{ 'customer.fields.zip' | t }}</label>
    <input id="AddrZip-{{ id }}" type="text" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code">
  </div>
</div>
<div class="contact-form__row">
  <div class="field">
    <label for="AddrCountry-{{ id }}">{{ 'customer.fields.country' | t }}</label>
    <select id="AddrCountry-{{ id }}" name="address[country]" autocomplete="country" data-default="{{ form.country }}">{{ all_country_option_tags }}</select>
  </div>
  <div class="field">
    <label for="AddrProvince-{{ id }}">{{ 'customer.fields.province' | t }}</label>
    <input id="AddrProvince-{{ id }}" type="text" name="address[province]" value="{{ form.province }}" autocomplete="address-level1">
  </div>
</div>
<div class="field">
  <label for="AddrPhone-{{ id }}">{{ 'customer.fields.phone' | t }}</label>
  <input id="AddrPhone-{{ id }}" type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
</div>
<label class="checkbox">
  {{ form.set_as_default_checkbox }}
  <span>{{ 'customer.addresses.set_default' | t }}</span>
</label>
