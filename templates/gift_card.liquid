{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_card.title' | t }} – {{ shop.name }}</title>
    {{ content_for_header }}
    <style>
      body { margin: 0; font-family: system-ui, sans-serif; background: {{ settings.color_background }}; color: {{ settings.color_text }}; }
      .gc { max-width: 520px; margin: 48px auto; padding: 32px; background: #fff; border-radius: 20px; text-align: center; box-shadow: 0 10px 40px rgba(0,0,0,.06); }
      .gc h1 { font-size: 22px; margin: 0 0 8px; }
      .gc__amount { font-size: 40px; font-weight: 700; color: {{ settings.color_accent }}; margin: 16px 0; }
      .gc__code { font-family: monospace; font-size: 20px; letter-spacing: 2px; padding: 12px; border: 2px dashed {{ settings.color_border }}; border-radius: 10px; margin: 16px 0; }
      .gc a, .gc button { display: inline-block; margin: 6px; padding: 12px 22px; border-radius: 999px; border: 0; background: {{ settings.color_accent }}; color: #fff; text-decoration: none; font-size: 15px; cursor: pointer; }
      .gc__qr { display: flex; justify-content: center; margin: 16px 0; }
    </style>
  </head>
  <body>
    <div class="gc">
      <p>{{ shop.name }}</p>
      <h1>{{ 'gift_card.title' | t }}</h1>
      {%- if gift_card.expired or gift_card.enabled != true -%}
        <p>{{ 'gift_card.unavailable' | t }}</p>
      {%- endif -%}
      <div class="gc__amount">{{ gift_card.balance | money }}</div>
      {%- if gift_card.balance != gift_card.initial_value -%}
        <p>{{ 'gift_card.initial' | t }}: {{ gift_card.initial_value | money }}</p>
      {%- endif -%}
      <div class="gc__code">{{ gift_card.code | format_code }}</div>
      {%- if gift_card.expires_on -%}
        <p>{{ 'gift_card.expires' | t }}: {{ gift_card.expires_on | date: '%d.%m.%Y' }}</p>
      {%- endif -%}
      <div class="gc__qr" id="QrCode"></div>
      <a href="{{ shop.url }}" target="_blank" rel="noopener">{{ 'gift_card.shop' | t }}</a>
      <button type="button" onclick="window.print()">{{ 'gift_card.print' | t }}</button>
      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}">Apple Wallet</a>
      {%- endif -%}
    </div>
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <script>
      window.addEventListener('load', function () {
        if (window.QRCode) new QRCode(document.getElementById('QrCode'), { text: {{ gift_card.qr_identifier | json }}, width: 120, height: 120 });
      });
    </script>
  </body>
</html>
