<div class="section account" style="--pt: 64px; --pb: 80px;">
  <div class="page-width account__narrow">
    <div class="account__card">
      <h1 class="h2">{{ 'customer.register.title' | t }}</h1>
      {%- form 'create_customer', class: 'account__form' -%}
        {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="contact-form__row">
          <div class="field">
            <label for="RegisterFirstName">{{ 'customer.fields.first_name' | t }}</label>
            <input id="RegisterFirstName" type="text" name="customer[first_name]" autocomplete="given-name">
          </div>
          <div class="field">
            <label for="RegisterLastName">{{ 'customer.fields.last_name' | t }}</label>
            <input id="RegisterLastName" type="text" name="customer[last_name]" autocomplete="family-name">
          </div>
        </div>
        <div class="field">
          <label for="RegisterEmail">{{ 'customer.fields.email' | t }}</label>
          <input id="RegisterEmail" type="email" name="customer[email]" autocomplete="email" required>
        </div>
        <div class="field">
          <label for="RegisterPassword">{{ 'customer.fields.password' | t }}</label>
          <input id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" required>
        </div>
        <label class="checkbox">
          <input type="checkbox" name="customer[accepts_marketing]" value="true">
          <span>{{ 'customer.register.marketing' | t }}</span>
        </label>
        <button type="submit" class="btn btn--full">{{ 'customer.register.submit' | t }}</button>
        <a href="{{ routes.account_login_url }}" class="account__link account__link--center">{{ 'customer.login.title' | t }}</a>
      {%- endform -%}
    </div>
  </div>
</div>
