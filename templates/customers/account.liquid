<div class="section account" style="--pt: 56px; --pb: 80px;">
  <div class="page-width">
    <div class="account__head">
      <div>
        <p class="eyebrow">{{ 'customer.account.title' | t }}</p>
        <h1 class="h1">{{ 'customer.account.hello' | t: name: customer.first_name }}</h1>
      </div>
      <a href="{{ routes.account_logout_url }}" class="btn btn--outline btn--small">{{ 'customer.account.logout' | t }}</a>
    </div>
    <div class="account__grid">
      <div class="account__card">
        <h2 class="h3">{{ 'customer.orders.title' | t }}</h2>
        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <table class="account__table">
              <thead><tr><th>{{ 'customer.orders.order' | t }}</th><th>{{ 'customer.orders.date' | t }}</th><th>{{ 'customer.orders.status' | t }}</th><th>{{ 'customer.orders.total' | t }}</th></tr></thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                    <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                    <td>{{ order.fulfillment_status_label }}</td>
                    <td>{{ order.total_net_amount | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
            {% render 'pagination', paginate: paginate %}
          {%- else -%}
            <p>{{ 'customer.orders.none' | t }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'cart.continue' | t }}</a>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
      <div class="account__card">
        <h2 class="h3">{{ 'customer.account.details' | t }}</h2>
        <p><strong>{{ customer.name }}</strong><br>{{ customer.email }}</p>
        {{ customer.default_address | format_address }}
        <a href="{{ routes.account_addresses_url }}" class="link-arrow">{{ 'customer.addresses.view' | t: count: customer.addresses_count }}{% render 'icon', name: 'arrow' %}</a>
      </div>
    </div>
  </div>
</div>
