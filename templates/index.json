    "faq": {
      "type": "faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Siparişim ne kadar sürede hazırlanır?",
            "answer": "<p>Hazırda olan tokalar 1–2 iş günü içinde kargoya verilir. Özel renk ve model siparişleri ürüne göre birkaç gün içinde örülüp gönderilir.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Tokalar tek mi, çift mi geliyor?",
            "answer": "<p>Tokalarımız kartında çift olarak gönderilir. Ürün sayfasında aksi belirtilmedikçe fiyat bir çift içindir.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "İstediğim renkte toka yaptırabilir miyim?",
            "answer": "<p>Elbette! Sipariş notuna rengini yazabilir ya da WhatsApp/Instagram'dan bize ulaşabilirsin.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Toptan satış yapıyor musunuz?",
            "answer": "<p>Evet. Butik, kırtasiye ve hediyelik eşya mağazaları için toptan toka siparişi alıyoruz. Adet ve model bilgisiyle bize yaz, teklifimizi iletelim.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Tokalar küçük çocuklar için uygun mu?",
            "answer": "<p>Tokalar ve amigurumilerde inci, boncuk ve göz gibi küçük parçalar bulunabilir. 3 yaş altı çocuklar için uygun değildir; küçük çocuklar yalnızca yetişkin gözetiminde kullanmalıdır.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "Örgü tokaların bakımı nasıl yapılır?",
            "answer": "<p>Kirlendiğinde ılık suda, hafif sabunla elde yıkayıp düz bir zeminde kurutabilirsin. Metal kısmın paslanmaması için iyice kurumasını bekle.</p>"
          }
        },
        "q7": {
          "type": "question",
          "settings": {
            "question": "Konya içinde elden teslim var mı?",
            "answer": "<p>Evet, Konya içi siparişlerde elden teslim seçeneğimiz var. Türkiye'nin her yerine kargo ile de gönderiyoruz.</p>"
          }
        },
        "q8": {
          "type": "question",
          "settings": {
            "question": "İsimli ürün yaptırabilir miyim?",
            "answer": "<p>Evet. Emzik askısı ve anahtarlıklarda istediğin ismi harf boncuklarla hazırlıyoruz. İsmi sipariş notuna yazman yeterli.</p>"
          }
        },
        "q9": {
          "type": "question",
          "settings": {
            "question": "Salkım toka nedir?",
            "answer": "<p>Uzun saçlar için tasarlanan, gül veya ayçiçeği başlı, saç boyunca sarkan örgü yapraklı tokalardır. Örgülü saçlarda ve özel günlerde çok güzel durur.</p>"
          }
        }
      },
