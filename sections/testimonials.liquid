<section class="section testimonials{% if section.settings.tinted %} section--tinted{% endif %}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section-head section-head--center">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
    </div>
    <ul class="testimonials__track" role="list">
      {%- for block in section.blocks -%}
        <li class="testimonial" {{ block.shopify_attributes }}>
          <div class="testimonial__stars" aria-label="{{ 'general.rating' | t: rating: block.settings.rating }}">
            {%- for i in (1..block.settings.rating) -%}{% render 'icon', name: 'star' %}{%- endfor -%}
          </div>
          <blockquote class="testimonial__quote">{{ block.settings.quote }}</blockquote>
          <div class="testimonial__author">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'testimonial__avatar', alt: block.settings.author }}
            {%- else -%}
              <span class="testimonial__avatar testimonial__avatar--initial">{{ block.settings.author | slice: 0 }}</span>
            {%- endif -%}
            <span>
              <strong>{{ block.settings.author }}</strong>
              {%- if block.settings.product != blank -%}<small>{{ block.settings.product }}</small>{%- endif -%}
            </span>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Müşteri yorumları",
  "class": "section-testimonials",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "default": "Sizden gelenler" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Mutlu müşterilerimiz" },
    { "type": "checkbox", "id": "tinted", "label": "Renkli arka plan", "default": true },
    { "type": "range", "id": "padding_top", "label": "Üst boşluk", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Alt boşluk", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Yorum",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Yorum", "default": "Ürün fotoğraflardakinden bile güzel geldi, paketlemesine bayıldım. Emeğinize sağlık!" },
        { "type": "text", "id": "author", "label": "İsim", "default": "Ayşe K." },
        { "type": "text", "id": "product", "label": "Aldığı ürün" },
        { "type": "range", "id": "rating", "label": "Puan", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "image_picker", "id": "image", "label": "Fotoğraf" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Müşteri yorumları",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "Kızımın doğumu için sipariş ettiğim amigurumi tavşan o kadar özenli ki, her detayı düşünülmüş. Emeğinize sağlık!", "author": "Zeynep A.", "product": "Amigurumi Tavşan" } },
        { "type": "testimonial", "settings": { "quote": "Battaniyenin yumuşaklığı ve renkleri harika. Hediye paketiyle geldi, çok şık duruyordu.", "author": "Elif D.", "product": "Bebek Battaniyesi" } },
        { "type": "testimonial", "settings": { "quote": "İstediğim renkte özel ördürdüm, süreç boyunca fotoğraflarla bilgilendirildim. Kesinlikle tekrar alacağım.", "author": "Merve Y.", "product": "Kişiye özel sipariş" } }
      ]
    }
  ]
}
{% endschema %}
