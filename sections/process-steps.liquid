<section class="section process" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section-head section-head--center">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
    </div>
    <ol class="process__list" role="list">
      {%- for block in section.blocks -%}
        <li class="process__step" {{ block.shopify_attributes }}>
          <span class="process__icon">{% render 'icon', name: block.settings.icon %}<span class="process__num">{{ forloop.index }}</span></span>
          <h3 class="h4">{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Nasıl hazırlanıyor",
  "class": "section-process",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "default": "İlmek ilmek" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Siparişin nasıl hazırlanıyor?" },
    { "type": "range", "id": "padding_top", "label": "Üst boşluk", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Alt boşluk", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Adım",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "İkon", "default": "yarn",
          "options": [
            { "value": "yarn", "label": "Yumak" },
            { "value": "hand", "label": "El" },
            { "value": "scissors", "label": "Makas" },
            { "value": "box", "label": "Paket" },
            { "value": "truck", "label": "Kargo" },
            { "value": "chat", "label": "Mesaj" },
            { "value": "heart", "label": "Kalp" },
            { "value": "gift", "label": "Hediye" }
          ]
        },
        { "type": "text", "id": "title", "label": "Başlık", "default": "Adım" },
        { "type": "textarea", "id": "text", "label": "Metin" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nasıl hazırlanıyor",
      "blocks": [
        { "type": "step", "settings": { "icon": "chat", "title": "Siparişini ver", "text": "Ürünü seç, renk ve isteklerini not olarak ekle." } },
        { "type": "step", "settings": { "icon": "yarn", "title": "İpliğini seçiyoruz", "text": "Sana özel, yumuşak ve kaliteli ipliklerle başlıyoruz." } },
        { "type": "step", "settings": { "icon": "hand", "title": "İlmek ilmek örüyoruz", "text": "Ürünün tamamen elde, özenle örülür." } },
        { "type": "step", "settings": { "icon": "gift", "title": "Paketleyip yolluyoruz", "text": "Hediye paketinde, güvenle kapına gelir." } }
      ]
    }
  ]
}
{% endschema %}
