<section class="section faq" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width faq__grid">
    <div class="faq__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="accordion">
      {%- for block in section.blocks -%}
        <details class="accordion__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary class="accordion__title">{{ block.settings.question }}<span class="accordion__icon">{% render 'icon', name: 'plus' %}</span></summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sık sorulan sorular",
  "class": "section-faq",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "default": "Merak edilenler" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Sık sorulan sorular" },
    { "type": "richtext", "id": "text", "label": "Metin", "default": "<p>Cevabını bulamadığın bir soru mu var? Bize WhatsApp veya Instagram'dan yazabilirsin.</p>" },
    { "type": "checkbox", "id": "open_first", "label": "İlk soru açık başlasın", "default": true },
    { "type": "range", "id": "padding_top", "label": "Üst boşluk", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Alt boşluk", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Soru",
      "settings": [
        { "type": "text", "id": "question", "label": "Soru", "default": "Soru" },
        { "type": "richtext", "id": "answer", "label": "Cevap", "default": "<p>Cevap</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sık sorulan sorular",
      "blocks": [
        { "type": "question", "settings": { "question": "Siparişim ne kadar sürede hazırlanır?", "answer": "<p>Ürünlerimiz sipariş üzerine elde örüldüğü için hazırlanma süresi ürüne göre genellikle 3–10 iş günüdür. Stokta olan ürünler 1–2 iş günü içinde kargoya verilir.</p>" } },
        { "type": "question", "settings": { "question": "Farklı renk veya ölçü isteyebilir miyim?", "answer": "<p>Elbette! Sipariş notuna isteğini yazabilir ya da WhatsApp'tan bize ulaşabilirsin. Kişiye özel siparişlerde renk ve ölçüyü birlikte belirliyoruz.</p>" } },
        { "type": "question", "settings": { "question": "Ürünler bebekler için güvenli mi?", "answer": "<p>Bebek ürünlerinde yumuşak, anti-alerjik bebek iplikleri kullanıyoruz. Amigurumilerde güvenlik gözleri sağlam şekilde sabitlenir; küçük bebekler için nakış göz tercih edebilirsin.</p>" } },
        { "type": "question", "settings": { "question": "Örgü ürünlerin bakımı nasıl yapılır?", "answer": "<p>30 derecede elde veya hassas programda yıkanmasını, sıkmadan ve düz bir zeminde kurutulmasını öneriyoruz. Çamaşır suyu ve kurutma makinesi kullanılmamalıdır.</p>" } },
        { "type": "question", "settings": { "question": "Kargo ve iade koşulları nelerdir?", "answer": "<p>Siparişler anlaşmalı kargo ile gönderilir. Kişiye özel hazırlanan ürünlerde iade kabul edilmemektedir; standart ürünlerde teslimattan itibaren 14 gün içinde iade hakkın vardır.</p>" } }
      ]
    }
  ]
}
{% endschema %}
