<section class="section insta" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section-head section-head--center">
      <div>
        <p class="eyebrow">{% render 'icon', name: 'instagram' %}{{ section.settings.handle }}</p>
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
    </div>
    <ul class="insta__grid" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: settings.social_instagram }}" class="insta__item{% unless block.settings.image %} card__media--ph-{{ forloop.index | modulo: 6 }}{% endunless %}" target="_blank" rel="noopener" aria-label="{{ 'general.instagram_post' | t }} {{ forloop.index }}">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200, 400, 600', sizes: '(min-width: 990px) 16vw, 33vw', alt: block.settings.image.alt }}
            {%- else -%}
              <span class="card__placeholder">{% render 'icon', name: 'yarn' %}</span>
            {%- endif -%}
            <span class="insta__overlay">{% render 'icon', name: 'instagram' %}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {%- if settings.social_instagram != blank -%}
      <div class="center-btn">
        <a href="{{ settings.social_instagram }}" class="btn btn--outline" target="_blank" rel="noopener">{% render 'icon', name: 'instagram' %}{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Instagram galerisi",
  "class": "section-instagram",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "handle", "label": "Kullanıcı adı", "default": "@ilknurun.ilmeklerii" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Instagram'da bizi takip et" },
    { "type": "text", "id": "button_label", "label": "Buton metni", "default": "Takip et" },
    { "type": "range", "id": "padding_top", "label": "Üst boşluk", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Alt boşluk", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Gönderi",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Görsel" },
        { "type": "url", "id": "link", "label": "Gönderi bağlantısı" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram galerisi",
      "blocks": [{ "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }]
    }
  ]
}
{% endschema %}
