{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured = current_variant.featured_media | default: product.featured_media
  assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' '
-%}

<section class="section main-product" style="--pt: 32px; --pb: 64px;" data-product-section data-section-id="{{ section.id }}" data-product-url="{{ product.url }}">
  <div class="page-width">
    <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
      {%- if collection -%}
        <span aria-hidden="true">/</span><a href="{{ collection.url }}">{{ collection.title }}</a>
      {%- endif -%}
      <span aria-hidden="true">/</span><span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="product">
      {%- comment -%} Galeri {%- endcomment -%}
      <div class="product__gallery" data-gallery>
        <ul class="product__media-list" role="list" data-media-list>
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <li class="product__media-item{% if media.id == featured.id %} is-active{% endif %}" data-media-id="{{ media.id }}">
                {%- if media.media_type == 'image' -%}
                  {%- liquid
                    assign loading = 'lazy'
                    if forloop.first
                      assign loading = 'eager'
                    endif
                  -%}
                  <a href="{{ media | image_url: width: 2000 }}" class="product__zoom" target="_blank" rel="noopener" aria-label="{{ 'products.product.zoom' | t }}">
                    {{ media | image_url: width: 1400 | image_tag: loading: loading, widths: '400, 600, 800, 1000, 1200, 1400', sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt | default: product.title }}
                  </a>
                {%- else -%}
                  <div class="product__video">{{ media | media_tag: image_size: '1200x' }}</div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          {%- else -%}
            <li class="product__media-item is-active">
              <div class="product__media-placeholder knit-bg">{% render 'icon', name: 'yarn' %}</div>
            </li>
          {%- endif -%}
        </ul>

        {%- if product.media.size > 1 -%}
          <ul class="product__thumbs" role="list">
            {%- for media in product.media -%}
              <li>
                <button type="button" class="product__thumb{% if media.id == featured.id %} is-active{% endif %}" data-thumb="{{ media.id }}" aria-label="{{ 'products.product.media_label' | t: index: forloop.index }}">
                  {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} Bilgiler {%- endcomment -%}
      <div class="product__info">
        <div class="product__info-inner">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}

              {%- when 'text' -%}
                <p class="product__eyebrow eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>

              {%- when 'title' -%}
                <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

              {%- when 'price' -%}
                <div class="product__price" {{ block.shopify_attributes }} data-price-wrap>
                  {% render 'price', product: product, use_variant: true %}
                  {%- if cart.taxes_included -%}
                    <small class="product__tax">{{ 'products.product.taxes_included' | t }}</small>
                  {%- endif -%}
                </div>

              {%- when 'handmade_info' -%}
                <div class="product__handmade" {{ block.shopify_attributes }}>
                  <div class="product__handmade-row">
                    {% render 'icon', name: 'hand' %}
                    <span><strong>{{ block.settings.title }}</strong>{{ block.settings.text }}</span>
                  </div>
                  {%- liquid
                    assign prep_time = product.metafields.custom.hazirlanma_suresi.value | default: block.settings.default_time
                  -%}
                  {%- if prep_time != blank -%}
                    <div class="product__handmade-row">
                      {% render 'icon', name: 'box' %}
                      <span><strong>{{ 'products.product.prep_time' | t }}</strong>{{ prep_time }}</span>
                    </div>
                  {%- endif -%}
                </div>

              {%- when 'variant_picker' -%}
                {%- unless product.has_only_default_variant -%}
                  <div class="variant-picker" {{ block.shopify_attributes }} data-variant-picker>
                    {%- for option in product.options_with_values -%}
                      <fieldset class="variant-picker__option" data-option-index="{{ forloop.index0 }}">
                        <legend>{{ option.name }}: <span data-option-value>{{ option.selected_value }}</span></legend>
                        <div class="variant-picker__values">
                          {%- for value in option.values -%}
                            {%- liquid
                              assign is_color = false
                              assign opt_name = option.name | downcase
                              if opt_name contains 'renk' or opt_name contains 'color' or opt_name contains 'colour'
                                assign is_color = true
                              endif
                            -%}
                            <input
                              type="radio"
                              id="Option-{{ section.id }}-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}"
                              name="option-{{ forloop.parentloop.index0 }}"
                              value="{{ value | escape }}"
                              {% if option.selected_value == value %}checked{% endif %}
                              class="visually-hidden"
                            >
                            <label
                              for="Option-{{ section.id }}-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}"
                              class="pill{% if is_color and value.swatch %} pill--swatch{% endif %}"
                              {% if is_color and value.swatch %}style="{% if value.swatch.color %}--swatch: {{ value.swatch.color }};{% endif %}{% if value.swatch.image %}--swatch-img: url({{ value.swatch.image | image_url: width: 80 }});{% endif %}"{% endif %}
                            >
                              {%- if is_color and value.swatch -%}<span class="pill__swatch" aria-hidden="true"></span>{%- endif -%}
                              {{ value }}
                            </label>
                          {%- endfor -%}
                        </div>
                      </fieldset>
                    {%- endfor -%}
                    <script type="application/json" data-variants-json>{{ product.variants | json }}</script>
                  </div>
                {%- endunless -%}

              {%- when 'buy_buttons' -%}
                <div class="product__buy" {{ block.shopify_attributes }}>
                  {%- form 'product', product, class: 'product-form', data-product-form: '', novalidate: 'novalidate' -%}
                    <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                    {%- if block.settings.show_note -%}
                      <div class="product-form__note">
                        <label for="Note-{{ section.id }}">{{ block.settings.note_label }}</label>
                        <textarea id="Note-{{ section.id }}" name="properties[{{ block.settings.note_label | escape }}]" rows="2" placeholder="{{ block.settings.note_placeholder | escape }}"></textarea>
                      </div>
                    {%- endif -%}
                    <div class="product-form__row">
                      {%- if block.settings.show_quantity -%}
                        <div class="qty" data-qty>
                          <button type="button" class="qty__btn" data-qty-minus aria-label="{{ 'products.product.quantity_decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
                          <label for="Quantity-{{ section.id }}" class="visually-hidden">{{ 'products.product.quantity' | t }}</label>
                          <input id="Quantity-{{ section.id }}" class="qty__input" type="number" name="quantity" value="1" min="1" inputmode="numeric">
                          <button type="button" class="qty__btn" data-qty-plus aria-label="{{ 'products.product.quantity_increase' | t }}">{% render 'icon', name: 'plus' %}</button>
                        </div>
                      {%- endif -%}
                      <button
                        type="submit"
                        name="add"
                        class="btn btn--full product-form__submit"
                        data-add-button
                        {% unless current_variant.available %}disabled{% endunless %}
                      >
                        <span data-add-label>
                          {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                        </span>
                      </button>
                    </div>
                    {%- if block.settings.show_dynamic_checkout -%}
                      <div class="product-form__dynamic">{{ form | payment_button }}</div>
                    {%- endif -%}
                    <p class="product-form__error" role="alert" data-form-error hidden></p>
                  {%- endform -%}
                </div>

              {%- when 'whatsapp' -%}
                {%- if wa_number != blank -%}
                  {%- assign wa_text = 'products.product.whatsapp_message' | t: title: product.title, url: canonical_url -%}
                  <a href="https://wa.me/{{ wa_number }}?text={{ wa_text | url_encode }}" class="btn btn--whatsapp btn--full" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
                    {% render 'icon', name: 'whatsapp' %}{{ block.settings.label }}
                  </a>
                {%- endif -%}

              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
                {%- endif -%}

              {%- when 'perks' -%}
                <ul class="product__perks" role="list" {{ block.shopify_attributes }}>
                  {%- if block.settings.perk_1 != blank -%}<li>{% render 'icon', name: 'truck' %}<span>{{ block.settings.perk_1 }}</span></li>{%- endif -%}
                  {%- if block.settings.perk_2 != blank -%}<li>{% render 'icon', name: 'gift' %}<span>{{ block.settings.perk_2 }}</span></li>{%- endif -%}
                  {%- if block.settings.perk_3 != blank -%}<li>{% render 'icon', name: 'shield' %}<span>{{ block.settings.perk_3 }}</span></li>{%- endif -%}
                </ul>

              {%- when 'collapsible_tab' -%}
                <details class="accordion__item accordion__item--product" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
                  <summary class="accordion__title">
                    <span class="accordion__label">{% render 'icon', name: block.settings.icon %}{{ block.settings.heading }}</span>
                    <span class="accordion__icon">{% render 'icon', name: 'plus' %}</span>
                  </summary>
                  <div class="accordion__content rte">
                    {{ block.settings.content }}
                    {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                  </div>
                </details>

              {%- when 'share' -%}
                <div class="product__share" {{ block.shopify_attributes }}>
                  <span>{{ 'products.product.share' | t }}</span>
                  <a href="https://wa.me/?text={{ product.title | append: ' ' | append: canonical_url | url_encode }}" target="_blank" rel="noopener" aria-label="WhatsApp">{% render 'icon', name: 'whatsapp' %}</a>
                  <a href="https://www.facebook.com/sharer/sharer.php?u={{ canonical_url | url_encode }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a>
                  <a href="https://pinterest.com/pin/create/button/?url={{ canonical_url | url_encode }}&description={{ product.title | url_encode }}" target="_blank" rel="noopener" aria-label="Pinterest">{% render 'icon', name: 'pinterest' %}</a>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_image -%}
      "image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],
    {%- endif -%}
    "description": {{ product.description | strip_html | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          {%- if variant.sku != blank -%}"sku": {{ variant.sku | json }},{%- endif -%}
          "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price": {{ variant.price | divided_by: 100.00 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "url": {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Ürün bilgileri",
  "class": "section-main-product",
  "blocks": [
    { "type": "@app" },
    { "type": "text", "name": "Üst etiket", "limit": 1, "settings": [{ "type": "text", "id": "text", "label": "Metin", "default": "El yapımı · Sipariş üzerine" }] },
    { "type": "title", "name": "Başlık", "limit": 1 },
    { "type": "price", "name": "Fiyat", "limit": 1 },
    {
      "type": "handmade_info", "name": "El yapımı bilgisi", "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Başlık", "default": "Tamamen el yapımı" },
        { "type": "text", "id": "text", "label": "Metin", "default": "Her ürün tek tek örüldüğü için küçük farklılıklar olabilir; bu onu benzersiz yapar." },
        { "type": "text", "id": "default_time", "label": "Varsayılan hazırlanma süresi", "info": "Ürüne özel süre için 'custom.hazirlanma_suresi' metafield'ını kullanabilirsiniz.", "default": "3–7 iş günü" }
      ]
    },
    { "type": "variant_picker", "name": "Varyant seçici", "limit": 1 },
    {
      "type": "buy_buttons", "name": "Satın alma butonları", "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "Adet seçici", "default": true },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Hızlı ödeme butonları", "default": true },
        { "type": "checkbox", "id": "show_note", "label": "Kişiselleştirme notu alanı", "info": "Örneğin isim işleme veya renk isteği.", "default": true },
        { "type": "text", "id": "note_label", "label": "Not alanı başlığı", "default": "Özel isteğin" },
        { "type": "text", "id": "note_placeholder", "label": "Not alanı örnek metni", "default": "Örn: İsim işlemesi 'Defne', pembe tonlarında" }
      ]
    },
    {
      "type": "whatsapp", "name": "WhatsApp'tan sor", "limit": 1,
      "settings": [{ "type": "text", "id": "label", "label": "Buton metni", "default": "WhatsApp'tan sor" }]
    },
    { "type": "description", "name": "Açıklama", "limit": 1 },
    {
      "type": "perks", "name": "Avantajlar", "limit": 1,
      "settings": [
        { "type": "text", "id": "perk_1", "label": "Avantaj 1 (kargo)", "default": "Belirli tutar üzeri ücretsiz kargo" },
        { "type": "text", "id": "perk_2", "label": "Avantaj 2 (hediye)", "default": "Ücretsiz hediye paketi" },
        { "type": "text", "id": "perk_3", "label": "Avantaj 3 (güvence)", "default": "Güvenli ödeme" }
      ]
    },
    {
      "type": "collapsible_tab", "name": "Açılır sekme",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "İkon", "default": "yarn",
          "options": [
            { "value": "yarn", "label": "Yumak" },
            { "value": "leaf", "label": "Yaprak" },
            { "value": "truck", "label": "Kargo" },
            { "value": "heart", "label": "Kalp" },
            { "value": "box", "label": "Paket" },
            { "value": "chat", "label": "Mesaj" }
          ]
        },
        { "type": "text", "id": "heading", "label": "Başlık", "default": "Malzeme ve ölçüler" },
        { "type": "richtext", "id": "content", "label": "İçerik" },
        { "type": "page", "id": "page", "label": "Sayfa içeriği (isteğe bağlı)" },
        { "type": "checkbox", "id": "open", "label": "Açık başlasın", "default": false }
      ]
    },
    { "type": "share", "name": "Paylaş", "limit": 1 }
  ]
}
{% endschema %}
