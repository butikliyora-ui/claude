<article class="section main-article" style="--pt: 56px; --pb: 80px;">
  <div class="page-width page-width--narrow">
    <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
      <a href="{{ blog.url }}">{{ blog.title }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ article.title }}</span>
    </nav>
    <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h1 class="h1">{{ article.title }}</h1>
    {%- if article.image -%}
      <div class="main-article__image">
        {{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 800px, 100vw', alt: article.title }}
      </div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
    <a href="{{ blog.url }}" class="link-arrow">{{ 'blog.back' | t }}{% render 'icon', name: 'arrow' %}</a>
  </div>
</article>

{% schema %}
{
  "name": "Blog yazısı",
  "class": "section-main-article",
  "settings": []
}
{% endschema %}
