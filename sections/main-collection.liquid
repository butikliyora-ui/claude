{%- paginate collection.products by section.settings.per_page -%}
  <section class="collection-hero{% if section.settings.show_image and collection.image %} collection-hero--image{% endif %}">
    {%- if section.settings.show_image and collection.image -%}
      <div class="collection-hero__media">
        {{ collection.image | image_url: width: 2000 | image_tag: loading: 'eager', widths: '750, 1100, 1500, 2000', sizes: '100vw', alt: collection.title }}
      </div>
    {%- endif -%}
    <div class="page-width collection-hero__inner">
      <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
        <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ collection.title }}</span>
      </nav>
      <h1 class="h1">{{ collection.title }}</h1>
      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="rte collection-hero__desc">{{ collection.description }}</div>
      {%- endif -%}
    </div>
  </section>

  <section class="section main-collection" style="--pt: 24px; --pb: 80px;">
    <div class="page-width">
      <form class="facets" data-facets-form action="{{ collection.url }}" method="get">
        <div class="facets__bar">
          {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
            <details class="facets__drawer" data-drawer-details>
              <summary class="btn btn--small btn--outline">{% render 'icon', name: 'filter' %}{{ 'collections.filter' | t }}</summary>
              <div class="mobile-menu__overlay" data-drawer-close></div>
              <div class="facets__panel" role="dialog" aria-modal="true" aria-label="{{ 'collections.filter' | t }}">
                <div class="mobile-menu__head">
                  <span class="mobile-menu__brand">{{ 'collections.filter' | t }}</span>
                  <button type="button" class="icon-btn" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
                </div>
                <div class="facets__groups">
                  {%- for filter in collection.filters -%}
                    <details class="facets__group" open>
                      <summary>{{ filter.label }}{% render 'icon', name: 'chevron' %}</summary>
                      {%- case filter.type -%}
                        {%- when 'list', 'boolean' -%}
                          <ul class="facets__list" role="list">
                            {%- for value in filter.values -%}
                              <li>
                                <label class="checkbox{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                                  <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %} data-facet-input>
                                  <span>{{ value.label }}</span>
                                  <small>({{ value.count }})</small>
                                </label>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- when 'price_range' -%}
                          <div class="facets__price">
                            <label>
                              <span>{{ 'collections.from' | t }}</span>
                              <input type="number" name="{{ filter.min_value.param_name }}" value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency | replace: ',', '' }}{% endif %}" placeholder="0" min="0" data-facet-input>
                            </label>
                            <label>
                              <span>{{ 'collections.to' | t }}</span>
                              <input type="number" name="{{ filter.max_value.param_name }}" value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency | replace: ',', '' }}{% endif %}" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}" min="0" data-facet-input>
                            </label>
                          </div>
                      {%- endcase -%}
                    </details>
                  {%- endfor -%}
                </div>
                <div class="facets__actions">
                  <a href="{{ collection.url }}?sort_by={{ collection.sort_by | default: collection.default_sort_by }}" class="btn btn--outline btn--small">{{ 'collections.clear' | t }}</a>
                  <button type="submit" class="btn btn--small">{{ 'collections.apply' | t }}</button>
                </div>
              </div>
            </details>
          {%- endif -%}

          <p class="facets__count">{{ 'collections.product_count' | t: count: collection.products_count }}</p>

          {%- if section.settings.enable_sorting -%}
            <label class="facets__sort">
              <span class="visually-hidden">{{ 'collections.sort_by' | t }}</span>
              <select name="sort_by" data-facet-input>
                {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
                {%- endfor -%}
              </select>
              {% render 'icon', name: 'chevron' %}
            </label>
          {%- endif -%}
        </div>

        {%- liquid
          assign active_count = 0
          for filter in collection.filters
            assign active_count = active_count | plus: filter.active_values.size
            if filter.min_value.value or filter.max_value.value
              assign active_count = active_count | plus: 1
            endif
          endfor
        -%}
        {%- if active_count > 0 -%}
          <div class="facets__active">
            {%- for filter in collection.filters -%}
              {%- for value in filter.active_values -%}
                <a href="{{ value.url_to_remove }}" class="facets__chip">{{ value.label }}{% render 'icon', name: 'close' %}</a>
              {%- endfor -%}
              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value or filter.max_value.value -%}
                  <a href="{{ filter.url_to_remove }}" class="facets__chip">
                    {{ filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money }}{% render 'icon', name: 'close' %}
                  </a>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </form>

      {%- if collection.products.size > 0 -%}
        <ul class="grid product-grid" role="list" style="--cols: {{ section.settings.columns }}; --cols-mobile: 2;">
          {%- for product in collection.products -%}
            {%- liquid
              assign lazy = true
              if forloop.index < 5
                assign lazy = false
              endif
            -%}
            <li>{% render 'product-card', product: product, lazy: lazy, color_handle: collection.handle %}</li>
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <div class="empty-state">
          {% render 'icon', name: 'yarn' %}
          <p>{{ 'collections.empty' | t }}</p>
          <a href="{{ collection.url }}" class="btn btn--outline">{{ 'collections.clear' | t }}</a>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Koleksiyon ürünleri",
  "class": "section-main-collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Sayfa başına ürün", "min": 8, "max": 48, "step": 4, "default": 16 },
    { "type": "range", "id": "columns", "label": "Masaüstü sütun sayısı", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_image", "label": "Koleksiyon görselini göster", "default": false },
    { "type": "checkbox", "id": "show_description", "label": "Koleksiyon açıklamasını göster", "default": true },
    { "type": "checkbox", "id": "enable_filtering", "label": "Filtreleme", "info": "Filtreleri Search & Discovery uygulamasından yönetebilirsiniz.", "default": true },
    { "type": "checkbox", "id": "enable_sorting", "label": "Sıralama", "default": true }
  ]
}
{% endschema %}
