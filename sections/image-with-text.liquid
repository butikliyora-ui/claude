{%- assign img = section.settings.image -%}
<section class="section image-text image-text--{{ section.settings.image_position }}{% if section.settings.tinted %} section--tinted{% endif %}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width image-text__grid">
    <div class="image-text__media">
      {%- if img -%}
        {{ img | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500, 750, 1000, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: img.alt | default: section.settings.heading }}
      {%- else -%}
        <div class="image-text__placeholder knit-bg"><span>{% render 'icon', name: 'yarn' %}</span></div>
      {%- endif -%}
      {%- if section.settings.badge != blank -%}
        <span class="image-text__badge">{{ section.settings.badge }}</span>
      {%- endif -%}
    </div>
    <div class="image-text__content">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {%- if section.settings.signature != blank -%}
        <p class="signature">{{ section.settings.signature }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--outline">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Görsel ve metin",
  "class": "section-image-text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Görsel" },
    {
      "type": "select", "id": "image_position", "label": "Görsel konumu", "default": "left",
      "options": [
        { "value": "left", "label": "Solda" },
        { "value": "right", "label": "Sağda" }
      ]
    },
    { "type": "text", "id": "badge", "label": "Görsel üstü etiket", "default": "Sevgiyle örüldü" },
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "default": "Hikayemiz" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Bir yumak iplikle başlayan hikaye" },
    { "type": "richtext", "id": "text", "label": "Metin", "default": "<p>Merhaba, ben İlknur. Yıllardır sevdiklerim için ördüğüm ürünler bir gün sizin de evinize konuk olsun istedim. Her parçayı kendi ellerimle, kullandığım ipliği tek tek seçerek, sabırla ve sevgiyle örüyorum.</p><p>Burada bulacağınız hiçbir ürün fabrikadan çıkmadı; hepsinin bir hikayesi, her ilmeğinde biraz emek var.</p>" },
    { "type": "text", "id": "signature", "label": "İmza", "default": "— İlknur" },
    { "type": "text", "id": "button_label", "label": "Buton metni", "default": "Daha fazlası" },
    { "type": "url", "id": "button_link", "label": "Buton bağlantısı" },
    { "type": "checkbox", "id": "tinted", "label": "Renkli arka plan", "default": true },
    { "type": "range", "id": "padding_top", "label": "Üst boşluk", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Alt boşluk", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Görsel ve metin" }]
}
{% endschema %}
