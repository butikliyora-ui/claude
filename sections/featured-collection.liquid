{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}
<section class="section featured-collection{% if section.settings.tinted %} section--tinted{% endif %}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading | default: collection.title }}</h2>
        {%- if section.settings.text != blank -%}<div class="section-head__text rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      {%- if section.settings.show_view_all -%}
        <a href="{{ collection.url | default: routes.all_products_collection_url }}" class="link-arrow">{{ 'general.view_all' | t }}{% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>

    <ul class="grid product-grid" role="list" style="--cols: {{ section.settings.columns }}; --cols-mobile: 2;">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- assign ph_titles = 'Çikolatalı Çilek Toka,Kiraz Toka,Nakışlı Oval Toka,Örgü Fiyonk Toka,Puf Papatya Toka,İnci Boncuklu Toka,Amigurumi Kuzu,Fincan İğnelik' | split: ',' -%}
        {%- assign ph_prices = '14900,12900,14900,16900,14900,12900,34900,89900' | split: ',' -%}
        {%- for i in (1..limit) -%}
          {%- assign idx = forloop.index0 | modulo: 8 -%}
          {%- assign p_price = ph_prices[idx] | plus: 0 -%}
          <li>{% render 'product-card', placeholder_title: ph_titles[idx], placeholder_price: p_price, placeholder_index: forloop.index %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Öne çıkan ürünler",
  "class": "section-featured-collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "default": "Yeni ilmekler" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Çok sevilenler" },
    { "type": "richtext", "id": "text", "label": "Açıklama" },
    { "type": "collection", "id": "collection", "label": "Koleksiyon" },
    { "type": "range", "id": "products_to_show", "label": "Ürün sayısı", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Masaüstü sütun sayısı", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "\"Tümünü gör\" bağlantısı", "default": true },
    { "type": "checkbox", "id": "tinted", "label": "Renkli arka plan", "default": false },
    { "type": "range", "id": "padding_top", "label": "Üst boşluk", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Alt boşluk", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "Öne çıkan ürünler" }]
}
{% endschema %}
