<section class="section newsletter" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="newsletter__card">
      <span class="newsletter__icon">{% render 'icon', name: 'heart' %}</span>
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- form 'customer', id: 'NewsletterSection', class: 'newsletter-form newsletter-form--large' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success">{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          <div class="newsletter-form__row">
            <label for="NewsletterSectionEmail" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
            <input id="NewsletterSectionEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.label' | t }}">
            <button type="submit" class="btn">{{ 'newsletter.button' | t }}</button>
          </div>
          {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "E-bülten",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "İlk siparişine özel indirim" },
    { "type": "richtext", "id": "text", "label": "Metin", "default": "<p>Bültenimize katıl; yeni modelleri, kampanyaları ve örgü dünyasından haberleri ilk sen öğren.</p>" },
    { "type": "range", "id": "padding_top", "label": "Üst boşluk", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Alt boşluk", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "E-bülten" }]
}
{% endschema %}
