<section class="section rich-text{% if section.settings.tinted %} section--tinted{% endif %}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width page-width--narrow rich-text__inner rich-text--{{ section.settings.align }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}
          <p class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
        {%- when 'heading' -%}
          <h2 class="h2" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
        {%- when 'text' -%}
          <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          <a href="{{ block.settings.link | default: '#' }}" class="btn{% if block.settings.outline %} btn--outline{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Zengin metin",
  "class": "section-rich-text",
  "settings": [
    {
      "type": "select", "id": "align", "label": "Hiza", "default": "center",
      "options": [
        { "value": "left", "label": "Sol" },
        { "value": "center", "label": "Orta" }
      ]
    },
    { "type": "checkbox", "id": "tinted", "label": "Renkli arka plan", "default": false },
    { "type": "range", "id": "padding_top", "label": "Üst boşluk", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Alt boşluk", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Üst etiket", "settings": [{ "type": "text", "id": "text", "label": "Metin", "default": "Etiket" }] },
    { "type": "heading", "name": "Başlık", "settings": [{ "type": "text", "id": "heading", "label": "Başlık", "default": "Başlık" }] },
    { "type": "text", "name": "Metin", "settings": [{ "type": "richtext", "id": "text", "label": "Metin", "default": "<p>Metninizi buraya yazın.</p>" }] },
    {
      "type": "button", "name": "Buton",
      "settings": [
        { "type": "text", "id": "label", "label": "Metin", "default": "Buton" },
        { "type": "url", "id": "link", "label": "Bağlantı" },
        { "type": "checkbox", "id": "outline", "label": "Çerçeveli stil", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zengin metin",
      "blocks": [{ "type": "heading" }, { "type": "text" }]
    }
  ]
}
{% endschema %}
