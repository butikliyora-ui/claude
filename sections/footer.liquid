<footer class="site-footer"{% unless section.settings.use_palette %} style="--f-bg: {{ section.settings.bg }}; --f-fg: {{ section.settings.fg }};"{% endunless %}>
  <div class="page-width">
    <div class="site-footer__grid">
      {%- for block in section.blocks -%}
        <div class="site-footer__col site-footer__col--{{ block.type }}" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'brand' -%}
              <p class="site-footer__brand">
                {{- 'logo-rozet.png' | asset_url | image_tag: class: 'site-footer__badge', width: 88, height: 88, alt: '', loading: 'lazy' -}}
                {{ shop.name }}
              </p>
              {%- if block.settings.text != blank -%}
                <div class="rte site-footer__text">{{ block.settings.text }}</div>
              {%- endif -%}
              {% render 'social-icons' %}
            {%- when 'menu' -%}
              <h2 class="site-footer__heading">{{ block.settings.heading | default: block.settings.menu.title }}</h2>
              <ul class="site-footer__links" role="list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            {%- when 'contact' -%}
              <h2 class="site-footer__heading">{{ block.settings.heading }}</h2>
              <ul class="site-footer__links" role="list">
                {%- if settings.whatsapp_number != blank -%}
                  <li><a href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">{% render 'icon', name: 'whatsapp' %}WhatsApp</a></li>
                {%- endif -%}
                {%- if settings.social_instagram != blank -%}
                  <li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">{% render 'icon', name: 'instagram' %}Instagram</a></li>
                {%- endif -%}
                {%- if settings.contact_email != blank -%}
                  <li><a href="mailto:{{ settings.contact_email }}">{% render 'icon', name: 'chat' %}{{ settings.contact_email }}</a></li>
                {%- endif -%}
              </ul>
              {%- if block.settings.text != blank -%}
                <div class="rte site-footer__text">{{ block.settings.text }}</div>
              {%- endif -%}
            {%- when 'newsletter' -%}
              <h2 class="site-footer__heading">{{ block.settings.heading }}</h2>
              {%- if block.settings.text != blank -%}<p class="site-footer__text">{{ block.settings.text }}</p>{%- endif -%}
              {%- form 'customer', id: 'FooterNewsletter', class: 'newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- if form.posted_successfully? -%}
                  <p class="form-message form-message--success">{{ 'newsletter.success' | t }}</p>
                {%- else -%}
                  <div class="newsletter-form__row">
                    <label for="FooterNewsletterEmail" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
                    <input id="FooterNewsletterEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.label' | t }}">
                    <button type="submit" class="newsletter-form__btn" aria-label="{{ 'newsletter.button' | t }}">{% render 'icon', name: 'arrow' %}</button>
                  </div>
                  {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
                {%- endif -%}
              {%- endform -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright }}</p>
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="payment-icons" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Alt bilgi",
  "class": "section-footer",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 5,
  "settings": [
    { "type": "checkbox", "id": "use_palette", "label": "Renk paletini kullan", "info": "Kapatırsan aşağıdaki renkler kullanılır.", "default": true },
    { "type": "color", "id": "bg", "label": "Arka plan", "default": "#3A2E2A" },
    { "type": "color", "id": "fg", "label": "Metin", "default": "#F3E9DC" },
    { "type": "text", "id": "copyright", "label": "Telif metni", "default": "Tüm hakları saklıdır. Her ürün sevgiyle, elde örülmüştür." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Ödeme ikonlarını göster", "default": true }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marka",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Metin", "default": "<p>Her biri ilmek ilmek, sevgiyle örülen el yapımı ürünler. Bebeğinize, evinize ve sevdiklerinize özel.</p>" }
      ]
    },
    {
      "type": "menu",
      "name": "Menü",
      "settings": [
        { "type": "text", "id": "heading", "label": "Başlık" },
        { "type": "link_list", "id": "menu", "label": "Menü", "default": "footer" }
      ]
    },
    {
      "type": "contact",
      "name": "İletişim",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Başlık", "default": "Bize ulaşın" },
        { "type": "richtext", "id": "text", "label": "Ek metin", "default": "<p>Siparişler ve özel istekler için hafta içi 09:00 – 19:00 arası yanıt veriyoruz.</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Bülten",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Başlık", "default": "Yeni ürünlerden haberdar ol" },
        { "type": "text", "id": "text", "label": "Metin", "default": "Yeni modeller ve kampanyalar önce abonelerimize." }
      ]
    }
  ]
}
{% endschema %}
