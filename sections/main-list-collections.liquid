<section class="section" style="--pt: 48px; --pb: 80px;">
  <div class="page-width">
    <div class="section-head section-head--center">
      <div><h1 class="h1">{{ section.settings.heading }}</h1></div>
    </div>
    <ul class="grid collection-list__grid" role="list" style="--cols: {{ section.settings.columns }}; --cols-mobile: 2;">
      {%- for collection in collections -%}
        {%- assign ph = forloop.index | modulo: 6 -%}
        <li>
          <a href="{{ collection.url }}" class="collection-tile">
            <span class="collection-tile__media{% unless collection.featured_image %} card__media--ph-{{ ph }}{% endunless %}">
              {%- if collection.featured_image -%}
                {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 990px) 25vw, 50vw', alt: collection.title }}
              {%- else -%}
                <span class="card__placeholder">{% render 'icon', name: 'yarn' %}</span>
              {%- endif -%}
            </span>
            <span class="collection-tile__title">{{ collection.title }}</span>
            <span class="collection-tile__count">{{ 'collections.product_count' | t: count: collection.products_count }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Tüm koleksiyonlar",
  "class": "section-list-collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Kategoriler" },
    { "type": "range", "id": "columns", "label": "Masaüstü sütun sayısı", "min": 2, "max": 5, "step": 1, "default": 4 }
  ]
}
{% endschema %}
