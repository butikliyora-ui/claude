<section class="section collection-list{% if section.settings.tinted %} section--tinted{% endif %}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="section-head section-head--center">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      </div>
    </div>

    <ul class="grid collection-list__grid" role="list" style="--cols: {{ section.settings.columns }}; --cols-mobile: 2;">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign img = block.settings.image | default: c.featured_image
          assign title = block.settings.title | default: c.title
          assign ph = forloop.index | modulo: 6
        -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ c.url | default: routes.collections_url }}" class="collection-tile">
            <span class="collection-tile__media{% unless img %} card__media--ph-{{ ph }}{% endunless %}">
              {%- if img -%}
                {{ img | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 990px) 20vw, 50vw', alt: title }}
              {%- else -%}
                <span class="card__placeholder">{% render 'icon', name: 'yarn' %}</span>
              {%- endif -%}
            </span>
            <span class="collection-tile__title">{{ title | default: 'Kategori' }}</span>
            {%- if c.products_count > 0 -%}
              <span class="collection-tile__count">{{ 'collections.product_count' | t: count: c.products_count }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Kategoriler",
  "class": "section-collection-list",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "default": "Kategoriler" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Ne arıyorsun?" },
    {
      "type": "select", "id": "columns", "label": "Masaüstü sütun sayısı", "default": "6",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ]
    },
    { "type": "checkbox", "id": "tinted", "label": "Renkli arka plan", "default": false },
    { "type": "range", "id": "padding_top", "label": "Üst boşluk", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Alt boşluk", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Kategori",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Koleksiyon" },
        { "type": "text", "id": "title", "label": "Başlık (isteğe bağlı)" },
        { "type": "image_picker", "id": "image", "label": "Görsel (isteğe bağlı)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kategoriler",
      "blocks": [
        { "type": "collection", "settings": { "title": "Amigurumi" } },
        { "type": "collection", "settings": { "title": "Bebek & Çocuk" } },
        { "type": "collection", "settings": { "title": "Hırka & Yelek" } },
        { "type": "collection", "settings": { "title": "Çanta" } },
        { "type": "collection", "settings": { "title": "Ev Dekorasyonu" } },
        { "type": "collection", "settings": { "title": "Aksesuar" } }
      ]
    }
  ]
}
{% endschema %}
