<section
  class="section related"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
  data-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width">
      <div class="section-head">
        <div><h2 class="h2">{{ section.settings.heading }}</h2></div>
      </div>
      <ul class="grid product-grid" role="list" style="--cols: {{ section.settings.limit }}; --cols-mobile: 2;">
        {%- for rec in recommendations.products -%}
          <li>{% render 'product-card', product: rec %}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Benzer ürünler",
  "class": "section-related",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Bunları da sevebilirsin" },
    { "type": "range", "id": "limit", "label": "Ürün sayısı", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "padding_top", "label": "Üst boşluk", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Alt boşluk", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 }
  ]
}
{% endschema %}
