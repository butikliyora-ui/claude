{%- paginate search.results by 16 -%}
  <section class="section main-search" style="--pt: 48px; --pb: 80px;">
    <div class="page-width">
      <div class="section-head section-head--center">
        <div>
          <h1 class="h1">{{ 'search.title' | t }}</h1>
          <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
            <label for="SearchPageInput" class="visually-hidden">{{ 'general.search' | t }}</label>
            <input id="SearchPageInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}">
            <input type="hidden" name="options[prefix]" value="last">
            <button type="submit" class="btn" aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'search' %}</button>
          </form>
          {%- if search.performed -%}
            <p class="search__count">{{ 'search.results_count' | t: count: search.results_count, terms: search.terms }}</p>
          {%- endif -%}
        </div>
      </div>

      {%- if search.performed -%}
        {%- if search.results_count > 0 -%}
          <ul class="grid product-grid" role="list" style="--cols: 4; --cols-mobile: 2;">
            {%- for item in search.results -%}
              <li>
                {%- if item.object_type == 'product' -%}
                  {% render 'product-card', product: item %}
                {%- else -%}
                  <a href="{{ item.url }}" class="search-result">
                    <small class="eyebrow">
                      {%- if item.object_type == 'article' -%}{{ 'search.types.article' | t }}{%- else -%}{{ 'search.types.page' | t }}{%- endif -%}
                    </small>
                    <strong>{{ item.title }}</strong>
                    <span>{{ item.content | strip_html | truncatewords: 20 }}</span>
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <div class="empty-state">
            {% render 'icon', name: 'search' %}
            <p>{{ 'search.no_results' | t: terms: search.terms }}</p>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Arama sonuçları",
  "class": "section-main-search",
  "settings": []
}
{% endschema %}
