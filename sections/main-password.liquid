<section class="password knit-bg">
  <div class="password__card">
    {{ 'logo-rozet.png' | asset_url | image_tag: class: 'password__badge', width: 140, height: 140, alt: shop.name }}
    <p class="site-logo__text">{{ shop.name }}</p>
    <h1 class="h2">{{ section.settings.heading }}</h1>
    <div class="rte">{{ shop.password_message | default: section.settings.text }}</div>

    {%- form 'customer', class: 'newsletter-form newsletter-form--large' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter-form__row">
          <label for="PasswordNewsletter" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
          <input id="PasswordNewsletter" type="email" name="contact[email]" required placeholder="{{ 'newsletter.label' | t }}">
          <button type="submit" class="btn">{{ 'newsletter.button' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary>{{ 'password.owner' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
        <label for="StorePassword" class="visually-hidden">{{ 'password.password' | t }}</label>
        <input id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
        <button type="submit" class="btn btn--outline">{{ 'password.enter' | t }}</button>
      {%- endform -%}
    </details>
    {% render 'social-icons' %}
  </div>
</section>

{% schema %}
{
  "name": "Şifre sayfası",
  "class": "section-password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Çok yakında açılıyoruz" },
    { "type": "richtext", "id": "text", "label": "Metin", "default": "<p>İlmek ilmek hazırlanıyoruz. Açılışta ilk sen haberdar olmak için e-postanı bırak.</p>" }
  ]
}
{% endschema %}
