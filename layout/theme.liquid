<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {%- liquid
      assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
      assign header_font_italic = settings.type_header_font | font_modify: 'style', 'italic'
      case settings.button_shape
        when 'pill'
          assign btn_radius = '999px'
        when 'rounded'
          assign btn_radius = '10px'
        else
          assign btn_radius = '0px'
      endcase
    -%}

    <style>
      {{ settings.type_header_font | font_face: font_display: 'swap' }}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_italic | font_face: font_display: 'swap' }}
      {{ header_font_italic | font_face: font_display: 'swap' }}

      :root {
        --font-heading: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
        --font-heading-weight: {{ settings.type_header_font.weight }};
        --font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-body-weight: {{ settings.type_body_font.weight }};
        --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
        --body-scale: {{ settings.body_scale | divided_by: 100.0 }};
        {% render 'color-vars' %}

        --page-width: {{ settings.page_width }}px;
        --radius: {{ settings.radius }}px;
        --radius-sm: {{ settings.radius | divided_by: 2 }}px;
        --btn-radius: {{ btn_radius }};
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="template-{{ template.name | handle }}{% if settings.show_knit_pattern %} has-knit-pattern{% endif %}">
    <a class="skip-link visually-hidden-focusable" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}

    {%- if settings.show_whatsapp_float and settings.whatsapp_number != blank -%}
      {% render 'whatsapp-button' %}
    {%- endif -%}

    <script>
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          recommendations: {{ routes.product_recommendations_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        moneyFormat: {{ shop.money_format | json }},
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          added: {{ 'products.product.added' | t | json }},
          error: {{ 'general.error' | t | json }}
        }
      };
    </script>
  </body>
</html>
